<style>
	* { margin: 0; padding: 0; box-sizing: border-box; }

  body {
  background-color: #ebe4c7;
  min-height: 100vh;
  padding: 0;
}


header {
  background-color: rgb(122, 122, 91);
  padding: 1rem;
  display: flex;
  align-items: center;
  
}
.izquierda, .centro, .derecha {
  flex: 1;
  display: flex;
  justify-content: center;
}
.logo {
	font-family: Georgia, serif;
    color: #e6e1da;
}
.buscador {
  width: 7cm;
  padding: 0.5rem 1rem;
  border: 1px solid #c4a882;
  border-radius: 20px;
  font-family: 'Lato', sans-serif;
  font-size: 1rem;
  background-color: white;
}
.izquierda{
	justify-content: flex-start;
	font-size: 27px;
}

.portada img{
  width: 3cm;
  height: 5cm;
  object-fit: cover;
  border-radius: 6px;
}

.grilla {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 1.5cm;
  padding: 2rem;
}

.estrellas {
  display: flex;
  gap: 2px;
  margin-top: 6px;
}

.estrella {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 1.7rem;
  color: #cccb9c;
}

.estrella.llena {
  color: #fffb00;
}
/*Aca esta la responsive. Si la pantalla es como la de una tablet se pone 3 columnas de libros, y si es un celular se ponen 2 columnas.*/
@media (max-width: 768px) {
  .grilla {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 400px) {
  .grilla {
    grid-template-columns: repeat(2, 1fr);
  }
}

.pie {
  text-align: center;
  padding: 2rem;
  margin-top: 2rem;
  color: #57513e;
  font-size: 0.9rem;
  border-top: 1px solid #4b453d;
